{
    "text"    : "Lock(l)",
    "label"   : "lock",
    "action"  : "hyprlock --quiet",
    "keybind" : "l"
}
{
    "text"    : "Suspend(t)",
    "label"   : "suspend",
    "action"  : "systemctl suspend",
    "keybind" : "t"
}
{
    "text"    : "Logout(e)",
    "label"   : "logout",
    "action"  : "hyprctl dispatch exit 0",
    "keybind" : "e"
}
{
    "text"    : "Shutdown(s)",
    "label"   : "shutdown",
    "action"  : "systemctl poweroff",
    "keybind" : "s"
}
{
    "text"    : "Reboot(r)",
    "label"   : "reboot",
    "action"  : "systemctl reboot",
    "keybind" : "r"
}
